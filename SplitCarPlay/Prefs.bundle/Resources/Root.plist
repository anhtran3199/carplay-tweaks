<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>title</key>
	<string>SplitCarPlay</string>
	<key>items</key>
	<array>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>SplitCarPlay</string>
			<key>footerText</key>
			<string>Split the CarPlay screen between two apps. Re-tap CarPlay (or reconnect) after changing settings.</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Mô phỏng (Preview)</string>
			<key>action</key>
			<string>openPreview:</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Enabled</string>
			<key>key</key>
			<string>enabled</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Apps</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>Left App (current)</string>
			<key>get</key>
			<string>currentLeftAppName</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Change Left App…</string>
			<key>action</key>
			<string>pickLeftApp:</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSTitleValueCell</string>
			<key>label</key>
			<string>Right App (current)</string>
			<key>get</key>
			<string>currentRightAppName</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSButtonCell</string>
			<key>label</key>
			<string>Change Right App…</string>
			<key>action</key>
			<string>pickRightApp:</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Layout</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSliderCell</string>
			<key>label</key>
			<string>Split Ratio (Left Width %)</string>
			<key>key</key>
			<string>splitRatio</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<real>0.5</real>
			<key>min</key>
			<real>0.2</real>
			<key>max</key>
			<real>0.8</real>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Show Divider Handle</string>
			<key>key</key>
			<string>showDivider</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Speed Bubble</string>
			<key>footerText</key>
			<string>Mirrors Vietmap Live's own current speed + speed-limit warning (not raw GPS). Requires Vietmap Live to be installed and running.</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Show Speed Bubble</string>
			<key>key</key>
			<string>showSpeedBubble</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>Bubble Style</string>
			<key>key</key>
			<string>bubbleStyle</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<integer>0</integer>
			<key>validTitles</key>
			<array>
				<string>Card</string>
				<string>Ring</string>
				<string>Bar</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
				<integer>2</integer>
			</array>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSLinkListCell</string>
			<key>label</key>
			<string>Bubble Position</string>
			<key>key</key>
			<string>bubblePosition</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<integer>1</integer>
			<key>validTitles</key>
			<array>
				<string>Left</string>
				<string>Right</string>
			</array>
			<key>validValues</key>
			<array>
				<integer>0</integer>
				<integer>1</integer>
			</array>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Over-Limit Alert Sound</string>
			<key>key</key>
			<string>speedAudioAlert</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Show Date/Time</string>
			<key>key</key>
			<string>showDate</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Show Battery %</string>
			<key>key</key>
			<string>showBattery</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Show Now Playing</string>
			<key>key</key>
			<string>showNowPlaying</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSGroupCell</string>
			<key>label</key>
			<string>Source App</string>
			<key>footerText</key>
			<string>Only Vietmap Live is supported right now. Waze/GOFA/WYN are planned but each needs its own reverse-engineered hook (different app, different mechanism) — see ROADMAP.md.</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Keep Vietmap Live Running in Background</string>
			<key>key</key>
			<string>keepSourceAppAlive</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<true/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

		<dict>
			<key>cell</key>
			<string>PSSwitchCell</string>
			<key>label</key>
			<string>Auto-Close Vietmap Live on CarPlay Disconnect</string>
			<key>key</key>
			<string>autoExitSourceApp</string>
			<key>defaults</key>
			<string>com.example.splitcarplay</string>
			<key>default</key>
			<false/>
			<key>PostNotification</key>
			<string>com.example.splitcarplay/reload</string>
		</dict>

	</array>
</dict>
</plist>
